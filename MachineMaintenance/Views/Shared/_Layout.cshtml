<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Machine Maintenance Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Maintenance" asp-action="Index">
                    🔧 Machine Maintenance
                </a>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Maintenance" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Maintenance" asp-action="Create">New Maintenance</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 - Machine Maintenance Management System
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
