<Window x:Class="MachineMaintenanceWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MachineMaintenanceWPF.Views"
        xmlns:vm="clr-namespace:MachineMaintenanceWPF.ViewModels"
        mc:Ignorable="d"
        Title="MTS- Loader" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceRecordsViewModel}">
            <views:MaintenanceRecordsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceFormViewModel}">
            <views:MaintenanceFormView/>
        </DataTemplate>
        
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#2c5f5f" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="150" Height="50" BorderBrush="White" BorderThickness="1" 
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="USER MODE :-" Foreground="White" FontSize="14" 
                              VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="MTS- Loader" Foreground="White" 
                          FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="label1" Foreground="White" FontSize="14" 
                          VerticalAlignment="Center" Margin="20,0"/>
            </Grid>
        </Border>

        <!-- Icon Toolbar -->
        <Border Grid.Row="1" Background="White" Padding="10" 
               BorderBrush="#ccc" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side Icons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Home -->
                    <Button Style="{StaticResource IconButton}" Background="#FFC964" 
                           Command="{Binding ShowDashboardCommand}" ToolTip="Home">
                        <TextBlock Text="🏠" FontSize="32"/>
                    </Button>

                    <!-- Notifications -->
                    <Button Style="{StaticResource IconButton}" Background="#E95D8C" ToolTip="Notifications">
                        <TextBlock Text="🔔" FontSize="32"/>
                    </Button>

                    <!-- Menu -->
                    <Button Style="{StaticResource IconButton}" Background="#6C7A89" ToolTip="Menu">
                        <TextBlock Text="☰" FontSize="32" Foreground="White"/>
                    </Button>

                    <!-- Analytics -->
                    <Button Style="{StaticResource IconButton}" Background="#4A90E2" 
                           Command="{Binding ShowRecordsCommand}" ToolTip="Analytics">
                        <TextBlock Text="📊" FontSize="32"/>
                    </Button>

                    <!-- Settings -->
                    <Button Style="{StaticResource IconButton}" Background="#95A5A6" ToolTip="Settings">
                        <TextBlock Text="⚙️" FontSize="32"/>
                    </Button>

                    <!-- Database -->
                    <Button Style="{StaticResource IconButton}" Background="#34495E" ToolTip="Database">
                        <TextBlock Text="💾" FontSize="32"/>
                    </Button>

                    <!-- Screen -->
                    <Button Style="{StaticResource IconButton}" Background="#5DADE2" ToolTip="Screen">
                        <TextBlock Text="🖥️" FontSize="32"/>
                    </Button>

                    <!-- Folder -->
                    <Button Style="{StaticResource IconButton}" Background="#F4D03F" ToolTip="Files">
                        <TextBlock Text="📁" FontSize="32"/>
                    </Button>
                </StackPanel>

                <!-- Right Side Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Play -->
                    <Button Style="{StaticResource IconButton}" Background="#7ED321" ToolTip="Start">
                        <TextBlock Text="▶" FontSize="32" Foreground="White"/>
                    </Button>

                    <!-- Pause -->
                    <Button Style="{StaticResource IconButton}" Background="#4A90E2" ToolTip="Pause">
                        <TextBlock Text="⏸" FontSize="32" Foreground="White"/>
                    </Button>

                    <!-- Stop -->
                    <Button Style="{StaticResource IconButton}" Background="#FF6B6B" ToolTip="Stop">
                        <TextBlock Text="⏹" FontSize="32" Foreground="White"/>
                    </Button>

                    <!-- Logout -->
                    <Button Style="{StaticResource IconButton}" Background="#E74C3C" ToolTip="Logout">
                        <Grid>
                            <TextBlock Text="⏻" FontSize="32" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="LOGOUT" FontSize="8" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="2" Background="Linear Gradient(135deg, #667eea 0%, #764ba2 100%)">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="20"/>
        </Border>
    </Grid>
</Window>
