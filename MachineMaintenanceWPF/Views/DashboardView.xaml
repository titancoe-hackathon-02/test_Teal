<UserControl x:Class="MachineMaintenanceWPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1350"
             Background="#e8e8e8">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Machine Health -->
        <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#333" BorderThickness="2" 
                CornerRadius="5" Margin="5" Padding="15">
            <StackPanel>
                <Border Background="#c0c0c0" Padding="8" Margin="-15,-15,-15,15" CornerRadius="3,3,0,0">
                    <TextBlock Text="Machine Health" FontWeight="Bold" FontSize="14" 
                              HorizontalAlignment="Center"/>
                </Border>
                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10">
                        <TextBlock Text="{Binding CurrentShift, StringFormat='Current Shift: {0}'}" Margin="0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Rectangle Fill="#00cc00" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding RunTime, StringFormat='Run Time: {0}'}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Rectangle Fill="#ff0000" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding DownTime, StringFormat='Down Time: {0}'}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Rectangle Fill="#ffff00" Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding IdleTime, StringFormat='Idle Time: {0}'}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalTime, StringFormat='Total Time: {0}'}" Margin="0,5" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <Ellipse Width="150" Height="150" Fill="#667eea" HorizontalAlignment="Right" Margin="20"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Machine Status -->
        <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="#333" BorderThickness="2" 
                CornerRadius="5" Margin="5" Padding="15">
            <StackPanel>
                <Grid Margin="-15,-15,-15,15">
                    <Border Background="#c0c0c0" Padding="8" CornerRadius="3,3,0,0">
                        <TextBlock Text="Machine Status" FontWeight="Bold" FontSize="14" 
                                  HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="Yellow" Padding="5,2" HorizontalAlignment="Right" 
                           BorderBrush="Black" BorderThickness="1" Margin="5">
                        <TextBlock Text="(Dry Run Mode)" FontWeight="Bold" FontSize="10"/>
                    </Border>
                </Grid>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pass Count" Padding="5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="-" Padding="5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PassCount, StringFormat='0.00'}" 
                              Padding="5" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Yield" Padding="5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="-" Padding="5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Yield, StringFormat='0.00'}" 
                              Padding="5" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Overall Count" Padding="5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="-" Padding="5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OverallCount, StringFormat='0.00'}" 
                              Padding="5" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CT _ Conv 1" Padding="5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="-" Padding="5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="00.00" 
                              Padding="5" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="CT _ Conv 2" Padding="5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="-" Padding="5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="00.00" 
                              Padding="5" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="UPH" Padding="5"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding UPH, StringFormat='0.00'}" 
                              Padding="5" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Vision Data -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Background="White" BorderBrush="#333" 
                BorderThickness="2" CornerRadius="5" Margin="5" Padding="15">
            <StackPanel>
                <Border Background="#c0c0c0" Padding="8" Margin="-15,-15,-15,15" CornerRadius="3,3,0,0">
                    <TextBlock Text="Vision Data" FontWeight="Bold" FontSize="14" 
                              HorizontalAlignment="Center"/>
                </Border>
                <Border BorderBrush="#999" BorderThickness="2" 
                       Height="150" Margin="0,10" Background="#f5f5f5">
                    <TextBlock Text="Camera Feed 1" Foreground="#999" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border BorderBrush="#999" BorderThickness="2" 
                       Height="150" Margin="0,10" Background="#f5f5f5">
                    <TextBlock Text="Camera Feed 2" Foreground="#999" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Running Log -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Background="White" BorderBrush="#333" 
                BorderThickness="2" CornerRadius="5" Margin="5" Padding="15">
            <StackPanel>
                <Border Background="#c0c0c0" Padding="8" Margin="-15,-15,-15,15" CornerRadius="3,3,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Running Log" Background="White" BorderThickness="1" 
                               Padding="15,5" Margin="2"/>
                        <Button Content="Live Alarm" Background="#d0d0d0" BorderThickness="1" 
                               Padding="15,5" Margin="2"/>
                        <Button Content="SFCS Log" Background="#d0d0d0" BorderThickness="1" 
                               Padding="15,5" Margin="2"/>
                        <Button Content="Current Steps" Background="#d0d0d0" BorderThickness="1" 
                               Padding="15,5" Margin="2"/>
                    </StackPanel>
                </Border>
                <Border Background="#f9f9f9" BorderBrush="#ddd" BorderThickness="1" MinHeight="200">
                    <TextBlock Text="i>tBox>RunningLog" Margin="10" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- SEMEMA Warning -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#333" BorderThickness="2" 
                CornerRadius="5" Margin="5" Padding="15">
            <Grid>
                <Border Background="#ff6666" BorderBrush="#cc0000" BorderThickness="2" 
                       Padding="15" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="SEMEMA TIMEOUT WARNING" FontWeight="Bold" 
                                  FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Jig1 Semema Signal Not Present...!!!" 
                                  FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>
                        <TextBlock Text="Jig2 Semema Signal Not Present...!!!" 
                                  FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- LoadCell Data -->
        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#333" BorderThickness="2" 
                CornerRadius="5" Margin="5" Padding="15">
            <StackPanel>
                <Border Background="#c0c0c0" Padding="8" Margin="-15,-15,-15,15" CornerRadius="3,3,0,0">
                    <TextBlock Text="LoadCell Data" FontWeight="Bold" FontSize="14" 
                              HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="No load cell data available" Foreground="#999" 
                          TextAlignment="Center" Margin="20"/>
            </StackPanel>
        </Border>

        <!-- SFC's -->
        <Border Grid.Row="3" Grid.Column="1" Background="White" BorderBrush="#333" BorderThickness="2" 
                CornerRadius="5" Margin="5" Padding="15">
            <StackPanel>
                <Border Background="#c0c0c0" Padding="8" Margin="-15,-15,-15,15" CornerRadius="3,3,0,0">
                    <TextBlock Text="SFC's" FontWeight="Bold" FontSize="14" 
                              HorizontalAlignment="Center"/>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="JIG 1" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Panel 1" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="JIG 2" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Panel 2" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="5"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Knob Data -->
        <Border Grid.Row="2" Grid.Column="2" Background="White" BorderBrush="#333" BorderThickness="2" 
                CornerRadius="5" Margin="5" Padding="10">
            <UniformGrid Rows="4" Columns="2">
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z1 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z5 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z2 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z6 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z3 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z7 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z4 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
                <Border Background="#f0f0f0" BorderBrush="#999" BorderThickness="1" Margin="3">
                    <TextBlock Text="Z8 Knob data" HorizontalAlignment="Center" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Semema Status -->
        <Border Grid.Row="3" Grid.Column="2" Background="White" BorderBrush="#333" BorderThickness="2" 
                CornerRadius="5" Margin="5" Padding="15">
            <StackPanel>
                <Border Background="#c0c0c0" Padding="8" Margin="-15,-15,-15,15" CornerRadius="3,3,0,0">
                    <TextBlock Text="Semema Status" FontWeight="Bold" FontSize="14" 
                              HorizontalAlignment="Center"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Semema Input" FontWeight="Bold" 
                              HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Grid.Column="1" Text="Semema Output" FontWeight="Bold" 
                              HorizontalAlignment="Center" Margin="0,0,0,10"/>
                </Grid>
                <UniformGrid Rows="5" Columns="2" Height="150">
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy1 Ready to Send" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy1 Ready to Receive" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy2 Ready to Send" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy2 Ready to Receive" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy1 Ready to Receive" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy1 Ready to Send" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy2 Ready to Receive" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Convy2 Ready to Send" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Jig Convy Ready to Send" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <Border Background="#e0e0e0" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="Jig Ready to Receive" TextAlignment="Center" 
                                      FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border Background="White" BorderBrush="#999" BorderThickness="1" Padding="3">
                            <TextBlock Text="-" TextAlignment="Center" FontSize="9"/>
                        </Border>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
